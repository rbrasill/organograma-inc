# Credenciais do MySQL para as rotas /api (importação por Excel).
# Copie este arquivo para .env.local (dev) e preencha — o .env NUNCA vai
# para o repositório (.gitignore já cobre .env*).
# Na Vercel: Settings → Environment Variables, com estes mesmos nomes.
#
# Os dados ficam no painel da hospedagem (ex.: cPanel → Bancos de dados MySQL).
DB_HOST=servidor.mysql.exemplo.com.br
DB_PORT=3306
DB_USER=rentis39_usuario
DB_PASSWORD=coloque_a_senha_aqui
DB_NAME=rentis39_organograma_inc
