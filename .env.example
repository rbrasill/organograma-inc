# Credenciais do MySQL para as rotas /api (importação por Excel).
# Copie este arquivo para .env.local (dev) e preencha — o .env NUNCA vai
# para o repositório (.gitignore já cobre .env*).
# Na Vercel: Settings → Environment Variables, com estes mesmos nomes.
#
# Os dados ficam no painel da hospedagem (ex.: cPanel → Bancos de dados MySQL).
DB_HOST=servidor.mysql.exemplo.com.br
DB_PORT=3306
DB_USER=rentis39_usuario
DB_PASSWORD=coloque_a_senha_aqui
DB_NAME=rentis39_organograma_inc

# Login por código de e-mail (docs/pipedream-auth/README.md)
# URL do workflow do Pipedream que ENVIA o e-mail com o código
PIPEDREAM_AUTH_URL=https://eo15edoyazwrfml.m.pipedream.net
# Segredo compartilhado com o Pipedream (header x-inc-secret) —
# tem que ser o MESMO valor configurado lá. Gere com: openssl rand -hex 32
INC_AUTH_SECRET=gere_um_segredo_longo_aleatorio
# Segredo que assina o cookie de sessão (independente do de cima)
AUTH_SESSION_SECRET=gere_outro_segredo_longo_aleatorio
